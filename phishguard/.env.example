# Leave EMPTY on Vercel: the app then calls /backend/... and vercel.json proxies it to the Render API,
# so the login cookie is first-party and never blocked as a third-party cookie.
# Set it only to talk to an API directly (needs PHISHGUARD_COOKIE_SAMESITE=None on the backend; some browsers still block that).
# VITE_API_URL=https://phishguard-667r.onrender.com
