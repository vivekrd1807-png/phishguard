# Required in production. Generate a long random value; never commit the real secret.
PHISHGUARD_ENV=production
PHISHGUARD_SECRET_KEY=replace-with-a-long-random-secret

# Exact browser origin(s), comma-separated. Do not add a trailing slash.
PHISHGUARD_ORIGINS=https://phishguard-im3h.vercel.app

# Keep Lax when frontend and API share the same site (e.g. app.example.com + api.example.com).
# Set to None only for genuinely cross-site frontend/API domains; requires HTTPS.
PHISHGUARD_COOKIE_SAMESITE=Lax

# Persistent database (recommended on Render): a PostgreSQL connection string, e.g. from Render Postgres, Neon or Supabase.
# When set, PHISHGUARD_DB is ignored and SQLite is not used.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# SQLite only (local dev, or a host with a persistent disk). Use an absolute path on a persistent disk. Example for a mounted disk:
PHISHGUARD_DB=/var/data/phishguard.db

# Optional: required for real password-reset email delivery.
# PHISHGUARD_SMTP_HOST=smtp.example.com
# PHISHGUARD_SMTP_PORT=587
# PHISHGUARD_SMTP_USER=your-smtp-user
# PHISHGUARD_SMTP_PASSWORD=your-smtp-password
# PHISHGUARD_SMTP_FROM=no-reply@example.com
